                <button type="submit" class="btn btn-primary btn-full">View Reward List</button>
            </form>
            <p class="auth-footer-text" id="auth-footer-text">Don't have an account? <a href="#" onclick="switchAuthTab('signup');return false;" style="color:var(--gold);">Sign Up</a></p>
            <p class="note">Accounts are stored locally on this device. Cross-device sync requires a backend server.</p>
        </div>
    </div>

    <!-- DASHBOARD SCREEN -->
    <div id="dashboard-screen" class="screen">
        <header class="dashboard-header">
            <div class="dashboard-header-left">
                <div>
                    <h2 id="dashboard-kingdom-name">Kingdom Name</h2>
