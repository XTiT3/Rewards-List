<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>ROK Kingdom Reward List</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0a0e17;
            --bg-card: #121a2b;
            --bg-input: #1a2338;
            --bg-hover: #1c2942;
            --border: #26334d;
            --border-light: #33415e;
            --gold: #f0b90b;
            --gold-hover: #ffd54f;
            --gold-glow: rgba(240, 185, 11, 0.25);
            --text: #e8edf5;
            --text-secondary: #9aa8c0;
            --text-muted: #5e6f8d;
            --danger: #ef4444;
            --danger-bg: rgba(239, 68, 68, 0.1);
            --success: #22c55e;
            --success-bg: rgba(34, 197, 94, 0.1);
            --shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            --shadow-lg: 0 4px 16px rgba(0, 0, 0, 0.3);
            --radius: 8px;
            --radius-sm: 5px;
            --radius-xs: 3px;
            --transition: 0.15s ease;
            --font-heading: 'Cinzel', serif;
            --font-body: 'Inter', sans-serif;
            --touch: 40px;
            --space-xs: 4px;
            --space-sm: 8px;
            --space-md: 12px;
            --space-lg: 16px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: var(--font-body);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.4;
            font-size: 14px;
        }

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-light);
            border-radius: 2px;
        }

        .screen {
            display: none;
            min-height: 100vh;
            animation: fadeIn 0.2s ease;
        }
        .screen.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* AUTH */
        #auth-screen {
            justify-content: center;
            align-items: center;
            padding: var(--space-md);
        }
        .auth-container {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: var(--space-lg);
            width: 100%;
            max-width: 400px;
            box-shadow: var(--shadow-lg);
            animation: slideUp 0.2s ease;
        }
        .auth-logo {
            text-align: center;
            margin-bottom: var(--space-md);
        }
        .auth-logo h1 {
            font-family: var(--font-heading);
            font-size: 20px;
            font-weight: 900;
            color: var(--gold);
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .auth-logo p {
            color: var(--text-secondary);
            font-size: 12px;
            margin-top: 2px;
        }
        .auth-tabs {
            display: flex;
            gap: 3px;
            background: var(--bg-input);
            border-radius: var(--radius-sm);
            padding: 3px;
            margin-bottom: var(--space-md);
        }
        .auth-tab {
            flex: 1;
            padding: 8px 4px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            border-radius: var(--radius-xs);
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
            min-height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-tab.active {
            background: var(--gold);
            color: #0a0e17;
        }
        .auth-tab:not(.active):hover {
            color: var(--text);
        }
        .form-group {
            margin-bottom: var(--space-sm);
            position: relative;
        }
        .form-group label {
            display: block;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .form-group input {
            width: 100%;
            padding: 10px 12px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-xs);
            color: var(--text);
            font-size: 14px;
            outline: none;
            transition: var(--transition);
            min-height: 38px;
            padding-right: 40px;
        }
        .form-group input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 2px var(--gold-glow);
        }
        .password-wrapper {
            position: relative;
        }
        .password-toggle {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            line-height: 1;
            min-width: 28px;
            min-height: 28px;
            border-radius: 3px;
            transition: var(--transition);
            font-weight: 600;
        }
        .password-toggle:hover {
            color: var(--text);
            background: var(--bg-hover);
        }
        .btn {
            padding: 10px 14px;
            border: none;
            border-radius: var(--radius-xs);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            min-height: 38px;
            touch-action: manipulation;
        }
        .btn-primary {
            background: var(--gold);
            color: #0a0e17;
        }
        .btn-primary:hover {
            background: var(--gold-hover);
        }
        .btn-secondary {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-light);
        }
        .btn-secondary:hover {
            border-color: var(--gold);
            color: var(--gold);
        }
        .btn-danger {
            background: transparent;
            color: var(--danger);
            border: 1px solid var(--danger);
        }
        .btn-danger:hover {
            background: var(--danger-bg);
        }
        .btn-sm {
            padding: 6px 8px;
            font-size: 10px;
            min-height: 32px;
        }
        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: var(--radius-xs);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }
        .btn-full {
            width: 100%;
        }
        .auth-error, .auth-success {
            font-size: 12px;
            margin-bottom: var(--space-sm);
            padding: 8px;
            border-radius: var(--radius-xs);
            display: none;
        }
        .auth-error {
            color: var(--danger);
            background: var(--danger-bg);
        }
        .auth-error.show {
            display: block;
        }
        .auth-success {
            color: var(--success);
            background: var(--success-bg);
        }
        .auth-success.show {
            display: block;
        }
        .auth-footer-text {
            text-align: center;
            margin-top: var(--space-sm);
            font-size: 11px;
            color: var(--text-muted);
        }
        .note {
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 8px;
            text-align: center;
        }

        /* DASHBOARD */
        #dashboard-screen {
            flex-direction: column;
        }
        .dashboard-header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: var(--space-sm) var(--space-md);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(6px);
        }
        .dashboard-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .dashboard-header-left h2 {
            font-family: var(--font-heading);
            font-size: 16px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 0.5px;
        }
        .dashboard-header-left .kingdom-name {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .dashboard-header-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .user-badge {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            background: var(--bg-input);
            border-radius: 14px;
            border: 1px solid var(--border);
            font-size: 11px;
            color: var(--text-secondary);
        }
        .role-badge {
            padding: 1px 6px;
            border-radius: 8px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .role-badge.owner {
            background: var(--gold-glow);
            color: var(--gold);
        }
        .role-badge.viewer {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
        }
        .role-badge.guest {
            background: var(--bg-input);
            color: var(--text-muted);
        }

        .dashboard-body {
            flex: 1;
            padding: var(--space-md);
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
        }

        /* Stats */
        .stats-row {
            display: flex;
            width: 100%;
            margin-bottom: var(--space-sm);
        }
        .stat-card {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 24px;
            text-align: center;
            box-shadow: var(--shadow);
        }
        .stat-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--text);
            font-family: var(--font-heading);
        }
        .stat-label {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 2px;
        }

        /* Controls */
        .controls-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: var(--space-sm);
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 8px;
        }
        .search-box {
            flex: 1;
            min-width: 140px;
        }
        .search-box input {
            width: 100%;
            padding: 8px 12px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-xs);
            color: var(--text);
            font-size: 13px;
            outline: none;
            min-height: 34px;
        }
        .filter-select {
            padding: 8px 10px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-xs);
            color: var(--text);
            font-size: 13px;
            outline: none;
            cursor: pointer;
            min-height: 34px;
            min-width: 100px;
        }
        .menu-container {
            position: relative;
        }
        .three-dot-btn {
            background: transparent;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xs);
            color: var(--text-secondary);
            cursor: pointer;
            padding: 6px 10px;
            font-size: 16px;
            line-height: 1;
            min-height: 34px;
            min-width: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }
        .three-dot-btn:hover {
            border-color: var(--gold);
            color: var(--gold);
        }
        .download-menu {
            position: absolute;
            right: 0;
            top: calc(100% + 4px);
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xs);
            box-shadow: var(--shadow-lg);
            min-width: 140px;
            z-index: 200;
            display: none;
            padding: 4px;
            max-height: 200px;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: var(--border-light) var(--bg-input);
        }
        .download-menu.show {
            display: block;
            animation: fadeIn 0.15s ease;
        }
        .download-menu button {
            display: block;
            width: 100%;
            text-align: left;
            background: none;
            border: none;
            color: var(--text);
            padding: 8px 12px;
            font-size: 12px;
            cursor: pointer;
            border-radius: var(--radius-xs);
            transition: var(--transition);
        }
        .download-menu button:hover {
            background: var(--bg-hover);
            color: var(--gold);
        }
        .download-menu::-webkit-scrollbar {
            width: 4px;
        }
        .download-menu::-webkit-scrollbar-track {
            background: var(--bg-input);
            border-radius: 2px;
        }
        .download-menu::-webkit-scrollbar-thumb {
            background: var(--border-light);
            border-radius: 2px;
        }

        /* Table */
        .table-container {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: visible;
            box-shadow: var(--shadow);
        }
        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            gap: 6px;
            flex-wrap: wrap;
            border-top-left-radius: var(--radius);
            border-top-right-radius: var(--radius);
            background: var(--bg-card);
        }
        .table-header h3 {
            font-family: var(--font-heading);
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .table-header-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .count-badge {
            background: var(--bg-input);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
            color: var(--text-secondary);
        }
        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-bottom-left-radius: var(--radius);
            border-bottom-right-radius: var(--radius);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 480px;
        }
        thead th {
            background: var(--bg-input);
            padding: 8px 10px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }
        tbody tr:hover {
            background: var(--bg-hover);
        }
        tbody td {
            padding: 8px 10px;
            font-size: 13px;
            vertical-align: middle;
        }
        .player-name {
            color: var(--gold);
            font-weight: 600;
            cursor: pointer;
        }
        .alliance-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .alliance-tag {
            display: inline-block;
            padding: 2px 6px;
            background: var(--bg-input);
            border: 1px solid var(--border-light);
            border-radius: 3px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            font-family: 'Courier New', monospace;
            color: var(--gold-hover);
            white-space: nowrap;
        }
        .table-actions {
            display: flex;
            gap: 4px;
            align-items: center;
        }
        .empty-state {
            text-align: center;
            padding: 20px 12px;
            color: var(--text-muted);
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(2px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 12px;
            animation: fadeIn 0.15s ease;
        }
        .modal-overlay.active {
            display: flex;
        }
        .modal {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius);
            padding: 14px;
            width: 100%;
            max-width: 380px;
            box-shadow: var(--shadow-lg);
            animation: slideUp 0.2s ease;
            max-height: 90vh;
            overflow-y: auto;
        }
        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .modal-header h3 {
            font-family: var(--font-heading);
            font-size: 16px;
            font-weight: 700;
        }
        .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            padding: 2px;
            min-width: 28px;
            min-height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-body {
            margin-bottom: 10px;
        }
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 6px;
            flex-wrap: wrap;
        }
        .alliance-input-row {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 6px;
        }
        .alliance-input-row input {
            flex: 1;
            padding: 8px 10px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-xs);
            color: var(--text);
            font-size: 13px;
            outline: none;
            min-height: 32px;
            text-transform: uppercase;
        }
        .alliance-input-row .remove-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            cursor: pointer;
            padding: 2px;
            min-width: 26px;
            min-height: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
        }
        .alliance-input-row .remove-btn:hover {
            color: var(--danger);
            background: var(--danger-bg);
        }
        .player-details-content {
            text-align: center;
        }
        .avatar-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--bg-input);
            border: 2px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin: 0 auto 8px;
            color: var(--gold);
            font-weight: 700;
        }
        .player-details-content h4 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .detail-sub {
            color: var(--text-muted);
            font-size: 11px;
            margin-bottom: 8px;
        }
        .alliance-section-detail {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            justify-content: center;
            margin-bottom: 8px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .dashboard-header {
                padding: 6px 10px;
            }
            .dashboard-body {
                padding: 8px;
            }
            .controls-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 4px;
                padding: 6px;
            }
            .search-box {
                min-width: 100%;
            }
            .stat-card {
                padding: 12px 16px;
            }
            .stat-value {
                font-size: 20px;
            }
            .auth-container {
                padding: 12px;
            }
            .auth-logo h1 {
                font-size: 18px;
            }
            .auth-tab {
                font-size: 10px;
                padding: 6px 2px;
                min-height: 32px;
            }
            .form-group input {
                padding: 8px 10px;
                min-height: 34px;
                font-size: 13px;
            }
            .btn {
                padding: 8px 10px;
                font-size: 10px;
                min-height: 34px;
            }
            .table-header h3 {
                font-size: 13px;
            }
            thead th {
                font-size: 9px;
                padding: 6px 8px;
            }
            tbody td {
                font-size: 12px;
                padding: 6px 8px;
            }
            .alliance-tag {
                font-size: 10px;
                padding: 2px 5px;
            }
        }
        @media (max-width: 480px) {
            .dashboard-header-left h2 {
                font-size: 14px;
            }
            .user-badge {
                font-size: 10px;
                padding: 2px 6px;
            }
            .dashboard-header-right .btn-sm {
                padding: 4px 6px;
                font-size: 9px;
                min-height: 28px;
            }
            .stat-card {
                padding: 8px 12px;
            }
            .stat-value {
                font-size: 18px;
            }
            .stat-label {
                font-size: 9px;
            }
            .modal {
                padding: 10px;
            }
        }
        @media print {
            body {
                background: #fff;
                color: #000;
            }
            .dashboard-header, .controls-bar, .download-menu, .table-actions,
            .stats-row, .modal-overlay, .btn, .search-box, .filter-select {
                display: none !important;
            }
            .dashboard-body {
                padding: 0;
            }
            .table-container {
                border: 1px solid #ccc;
                box-shadow: none;
            }
            table {
                min-width: 100%;
            }
            thead th {
                background: #f0f0f0;
                color: #000;
                border-bottom: 2px solid #333;
                font-size: 10px;
            }
            tbody td {
                color: #000;
                border-bottom: 1px solid #ddd;
                font-size: 12px;
            }
            .alliance-tag {
                background: #f5f5f5;
                border: 1px solid #ddd;
                color: #333;
                font-size: 10px;
            }
            .player-name {
                color: #000;
                text-decoration: none;
            }
        }
    </style>
</head>
<body>

    <!-- AUTH SCREEN -->
    <div id="auth-screen" class="screen">
        <div class="auth-container">
            <div class="auth-logo">
