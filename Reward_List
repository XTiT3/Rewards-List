                    <div class="alliance-section-detail" id="details-alliances"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('details-modal')">Close</button>
                <button class="btn btn-primary" id="details-edit-btn" onclick="openEditFromDetails()">Edit</button>
            </div>
        </div>
    </div>

    <script>
        const STORAGE_KEYS = { users: 'rok_users', kingdom: 'rok_kingdom', session: 'rok_session' };

        function getUsers() { try { return JSON.parse(localStorage.getItem(STORAGE_KEYS.users)) || []; } catch { return []; } }
        function saveUsers(users) { localStorage.setItem(STORAGE_KEYS.users, JSON.stringify(users)); }
        function getKingdom() { try { return JSON.parse(localStorage.getItem(STORAGE_KEYS.kingdom)) || null; } catch { return null; } }
        function saveKingdom(kingdom) { localStorage.setItem(STORAGE_KEYS.kingdom, JSON.stringify(kingdom)); }
        function getSession() { try { return JSON.parse(localStorage.getItem(STORAGE_KEYS.session)) || null; } catch { return null; } }
        function saveSession(session) { localStorage.setItem(STORAGE_KEYS.session, JSON.stringify(session)); }
        function clearSession() { localStorage.removeItem(STORAGE_KEYS.session); }
        function generateId() { return Date.now().toString(36) + Math.random().toString(36).substring(2, 8); }

        // Secure password hashing using SHA-256 and a random salt
        async function hashPassword(password, salt = null) {
            if (!salt) {
                salt = crypto.getRandomValues(new Uint8Array(16)).join('');
            }
            const encoder = new TextEncoder();
            const data = encoder.encode(password + salt);
            const hashBuffer = await crypto.subtle.digest('SHA-256', data);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
            return { salt, hash: hashHex };
        }

        async function verifyPassword(password, salt, expectedHash) {
            const { hash } = await hashPassword(password, salt);
            return hash === expectedHash;
        }

        let currentUser = null;
        let currentKingdom = null;
        let editingPlayerId = null;
        let detailsPlayerId = null;

        // Toggle password visibility
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = 'Hide';
            } else {
                input.type = 'password';
                btn.textContent = 'Show';
            }
        }

        // Toggle download menu
        function toggleDownloadMenu() {
            const menu = document.getElementById('download-menu');
            menu.classList.toggle('show');
        }

        // Close download menu when clicking outside
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('download-menu');
            const btn = document.getElementById('download-menu-btn');
            if (menu && btn && !menu.contains(event.target) && !btn.contains(event.target)) {
                menu.classList.remove('show');
            }
        });

        // Alliance input management
        function addAllianceInput(value = '') {
            const container = document.getElementById('alliance-inputs-container');
            const row = document.createElement('div');
            row.className = 'alliance-input-row';
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'Enter alliance tag';
            input.maxLength = 10;
            input.value = value;
            input.style.textTransform = 'uppercase';
            input.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'remove-btn';
            removeBtn.innerHTML = '×';
            removeBtn.onclick = function() { row.remove(); };
            row.appendChild(input);
            row.appendChild(removeBtn);
            container.appendChild(row);
        }

        function clearAllianceInputs() {
            document.getElementById('alliance-inputs-container').innerHTML = '';
        }

        function setAllianceInputs(tags) {
            clearAllianceInputs();
            if (tags && tags.length > 0) {
                tags.forEach(tag => addAllianceInput(tag));
            }
            addAllianceInput();
        }

        function getAllianceTagsFromInputs() {
            const inputs = document.querySelectorAll('#alliance-inputs-container input');
            const tags = [];
            inputs.forEach(input => {
                const val = input.value.trim().toUpperCase();
                if (val && val.length >= 1 && /^[A-Z0-9]+$/.test(val)) {
                    tags.push(val);
                }
            });
            return tags;
        }

        // Auth functions
        function switchAuthTab(tab) {
            document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
            document.querySelector(`.auth-tab[data-tab="${tab}"]`).classList.add('active');
            document.getElementById('signin-form').style.display = tab === 'signin' ? 'block' : 'none';
            document.getElementById('signup-form').style.display = tab === 'signup' ? 'block' : 'none';
            document.getElementById('guest-view-form').style.display = tab === 'view' ? 'block' : 'none';
            const footer = document.getElementById('auth-footer-text');
            if (tab === 'signin') footer.innerHTML = 'Don\'t have an account? <a href="#" onclick="switchAuthTab(\'signup\');return false;" style="color:var(--gold);">Sign Up</a>';
            else if (tab === 'signup') footer.innerHTML = 'Already have an account? <a href="#" onclick="switchAuthTab(\'signin\');return false;" style="color:var(--gold);">Sign In</a>';
            else footer.innerHTML = 'Want full access? <a href="#" onclick="switchAuthTab(\'signup\');return false;" style="color:var(--gold);">Sign Up</a> or <a href="#" onclick="switchAuthTab(\'signin\');return false;" style="color:var(--gold);">Sign In</a>';
            hideAuthMessages();
            const kingdom = getKingdom();
            if (tab === 'signup') {
                document.getElementById('kingdom-name-group').style.display = kingdom ? 'none' : 'block';
                document.getElementById('signup-kingdom').required = !kingdom;
            }
        }

        function showAuthError(msg) { const el=document.getElementById('auth-error'); el.textContent=msg; el.classList.add('show'); document.getElementById('auth-success').classList.remove('show'); }
        function showAuthSuccess(msg) { const el=document.getElementById('auth-success'); el.textContent=msg; el.classList.add('show'); document.getElementById('auth-error').classList.remove('show'); }
        function hideAuthMessages() { document.getElementById('auth-error').classList.remove('show'); document.getElementById('auth-success').classList.remove('show'); }

        async function handleSignUp(e) {
            e.preventDefault(); hideAuthMessages();
            const username = document.getElementById('signup-username').value.trim();
            const password = document.getElementById('signup-password').value;
            const kingdomName = document.getElementById('signup-kingdom').value.trim();
            if (!username || !password || (!getKingdom() && !kingdomName)) { showAuthError('Please fill in all fields.'); return; }
            if (password.length < 6) { showAuthError('Password must be at least 6 characters.'); return; }
            const users = getUsers();
            if (users.some(u => u.username.toLowerCase() === username.toLowerCase())) { showAuthError('This username is already taken.'); return; }

            const { salt, hash } = await hashPassword(password);
            const userId = generateId();
            const newUser = { id: userId, username, salt, passwordHash: hash, isOwner: !getKingdom(), createdAt: new Date().toISOString() };
            users.push(newUser); saveUsers(users);

            let kingdom;
            const existingKingdom = getKingdom();
            if (!existingKingdom) {
                kingdom = { id: generateId(), name: kingdomName, ownerId: userId, ownerName: username, players: [], createdAt: new Date().toISOString() };
                saveKingdom(kingdom);
            } else {
                kingdom = existingKingdom;
                showAuthSuccess('Account created! You are a viewer of ' + kingdom.name + '.');
            }

            saveSession({ userId, username, isOwner: newUser.isOwner });
            currentUser = newUser; currentKingdom = kingdom; enterDashboard();
        }

        async function handleSignIn(e) {
            e.preventDefault(); hideAuthMessages();
            const username = document.getElementById('signin-username').value.trim();
            const password = document.getElementById('signin-password').value;
            if (!username || !password) { showAuthError('Please enter your username and password.'); return; }
            const users = getUsers();
            const user = users.find(u => u.username.toLowerCase() === username.toLowerCase());
            if (!user) { showAuthError('No account found with that username.'); return; }
            const isValid = await verifyPassword(password, user.salt, user.passwordHash);
            if (!isValid) { showAuthError('Incorrect password.'); return; }
            const kingdom = getKingdom();
            if (!kingdom) { showAuthError('No kingdom found. Please sign up first.'); return; }
            saveSession({ userId: user.id, username: user.username, isOwner: user.isOwner });
            currentUser = user; currentKingdom = kingdom; enterDashboard();
        }

        function handleGuestView(e) {
            e.preventDefault(); hideAuthMessages();
            const kingdomId = document.getElementById('guest-kingdom-id').value.trim().toLowerCase();
            if (!kingdomId) { showAuthError('Please enter a kingdom or owner username.'); return; }
            const kingdom = getKingdom();
            if (!kingdom) { showAuthError('No kingdom exists yet.'); return; }
            const users = getUsers();
            const owner = users.find(u => u.isOwner);
            if (!owner) { showAuthError('Kingdom owner not found.'); return; }
            const matchesKingdom = kingdom.name.toLowerCase().includes(kingdomId);
            const matchesOwner = owner.username.toLowerCase().includes(kingdomId);
            if (!matchesKingdom && !matchesOwner) { showAuthError('No matching kingdom or owner found.'); return; }
            currentUser = { id: 'guest', username: 'Guest Viewer', isOwner: false };
            currentKingdom = kingdom; enterDashboard();
        }

        function handleLogout() {
            if (currentUser && currentUser.id === 'guest') {
                currentUser = null; currentKingdom = null;
                document.getElementById('auth-screen').classList.add('active');
                document.getElementById('dashboard-screen').classList.remove('active');
                switchAuthTab('view');
            } else {
                clearSession();
                currentUser = null; currentKingdom = null;
                document.getElementById('auth-screen').classList.add('active');
                document.getElementById('dashboard-screen').classList.remove('active');
                switchAuthTab('signin');
            }
            editingPlayerId = null; detailsPlayerId = null; hideAuthMessages();
        }

        function enterDashboard() {
            document.getElementById('auth-screen').classList.remove('active');
            document.getElementById('dashboard-screen').classList.add('active');
            document.getElementById('dashboard-kingdom-name').textContent = currentKingdom.name;
            document.getElementById('dashboard-owner-label').textContent = 'Owner: ' + (currentKingdom.ownerName || 'Unknown');
            document.getElementById('dashboard-username').textContent = currentUser.username;
            const roleBadge = document.getElementById('dashboard-role-badge');
            if (currentUser.isOwner) { roleBadge.textContent='Owner'; roleBadge.className='role-badge owner'; }
            else if (currentUser.id === 'guest') { roleBadge.textContent='Guest'; roleBadge.className='role-badge guest'; }
            else { roleBadge.textContent='Viewer'; roleBadge.className='role-badge viewer'; }
            const isOwner = currentUser.isOwner;
            document.getElementById('actions-header').style.display = isOwner ? 'table-cell' : 'none';
            document.getElementById('add-player-btn').style.display = isOwner ? 'inline-flex' : 'none';
            document.getElementById('logout-button').textContent = currentUser.id === 'guest' ? 'Exit View' : 'Log Out';
            renderAll();
        }

        function renderAll() {
            updateStats();
            populateFilterDropdown();
            renderTable();
        }

        function updateStats() {
            const players = currentKingdom?.players || [];
            document.getElementById('stat-players').textContent = players.length;
            document.getElementById('table-count').textContent = `${players.length} player${players.length !== 1 ? 's' : ''}`;
        }

        function populateFilterDropdown() {
            const filter = document.getElementById('filter-alliance');
            const currentVal = filter.value;
            filter.innerHTML = '<option value="">All Alliances</option>';
            const tags = new Set((currentKingdom?.players || []).flatMap(p => p.alliances || []));
            tags.forEach(tag => {
                const opt = document.createElement('option');
                opt.value = tag;
                opt.textContent = tag;
                filter.appendChild(opt);
            });
            if (currentVal) filter.value = currentVal;
        }

        function renderTable() {
            const tbody = document.getElementById('player-table-body');
            const emptyState = document.getElementById('empty-state');
            const searchTerm = document.getElementById('search-input').value.toLowerCase().trim();
            const filterAlliance = document.getElementById('filter-alliance').value;
            const isOwner = currentUser?.isOwner || false;
            let players = currentKingdom?.players || [];
            players = [...players].sort((a,b) => a.name.localeCompare(b.name));
            if (searchTerm) {
                players = players.filter(p => p.name.toLowerCase().includes(searchTerm) || (p.alliances||[]).some(tag => tag.toLowerCase().includes(searchTerm)));
            }
            if (filterAlliance) {
                players = players.filter(p => (p.alliances||[]).includes(filterAlliance));
            }

            tbody.innerHTML = '';
            if (players.length === 0) { emptyState.style.display = 'block'; return; }
            emptyState.style.display = 'none';
            players.forEach((player, index) => {
                const tr = document.createElement('tr');
                const tdNum = document.createElement('td'); tdNum.textContent = index+1; tdNum.style.color='var(--text-muted)'; tdNum.style.fontSize='11px'; tr.appendChild(tdNum);
                const tdName = document.createElement('td');
                const nameSpan = document.createElement('span'); nameSpan.className='player-name'; nameSpan.textContent = player.name; nameSpan.onclick = () => openPlayerDetails(player.id); tdName.appendChild(nameSpan); tr.appendChild(tdName);
                const tdAlliances = document.createElement('td');
                const tagContainer = document.createElement('div'); tagContainer.className='alliance-tags';
                if (!player.alliances || player.alliances.length === 0) {
                    tagContainer.innerHTML = '<span style="color:var(--text-muted);font-size:11px;">—</span>';
                } else {
                    player.alliances.forEach(tag => {
                        const span = document.createElement('span'); span.className='alliance-tag'; span.textContent = tag; tagContainer.appendChild(span);
                    });
                }
                tdAlliances.appendChild(tagContainer); tr.appendChild(tdAlliances);

                if (isOwner) {
                    const tdActions = document.createElement('td');
                    tdActions.className = 'table-actions';
                    const editBtn = document.createElement('button'); editBtn.className='btn btn-secondary btn-sm btn-icon'; editBtn.textContent='Edit'; editBtn.title='Edit'; editBtn.onclick = () => openEditPlayerModal(player.id); tdActions.appendChild(editBtn);
                    const delBtn = document.createElement('button'); delBtn.className='btn btn-danger btn-sm btn-icon'; delBtn.textContent='Del'; delBtn.title='Remove'; delBtn.onclick = () => removePlayer(player.id); tdActions.appendChild(delBtn);
                    tr.appendChild(tdActions);
                }

                tbody.appendChild(tr);
            });
            updateStats();
        }

        function openAddPlayerModal() {
            if (!currentUser?.isOwner) return;
            editingPlayerId = null;
            document.getElementById('player-modal-title').textContent = 'Add Player';
            document.getElementById('player-name-input').value = '';
            clearAllianceInputs();
            addAllianceInput();
            document.getElementById('player-modal').classList.add('active');
        }

        function openEditPlayerModal(playerId) {
            if (!currentUser?.isOwner) return;
            const player = currentKingdom.players.find(p => p.id === playerId);
            if (!player) return;
            editingPlayerId = playerId;
            document.getElementById('player-modal-title').textContent = 'Edit Player';
            document.getElementById('player-name-input').value = player.name;
            setAllianceInputs(player.alliances || []);
            document.getElementById('player-modal').classList.add('active');
        }

        function handlePlayerSubmit(e) {
            e.preventDefault();
            if (!currentUser?.isOwner) return;
            const name = document.getElementById('player-name-input').value.trim();
            if (!name) return;
            const alliances = getAllianceTagsFromInputs();
            if (editingPlayerId) {
                const player = currentKingdom.players.find(p => p.id === editingPlayerId);
                if (player) {
                    player.name = name;
                    player.alliances = alliances;
                }
            } else {
                currentKingdom.players.push({ id: generateId(), name, alliances, createdAt: new Date().toISOString() });
            }
            saveKingdom(currentKingdom);
            closeModal('player-modal');
            renderAll();
        }

        function removePlayer(playerId) {
            if (!currentUser?.isOwner) return;
            if (!confirm('Remove this player?')) return;
            currentKingdom.players = currentKingdom.players.filter(p => p.id !== playerId);
            saveKingdom(currentKingdom);
            renderAll();
        }

        function openPlayerDetails(playerId) {
            const player = currentKingdom.players.find(p => p.id === playerId);
            if (!player) return;
            detailsPlayerId = playerId;
            document.getElementById('details-avatar').textContent = player.name.charAt(0).toUpperCase();
            document.getElementById('details-name').textContent = player.name;
            document.getElementById('details-id').textContent = 'ID: ' + player.id.substring(0,10) + '...';
            const allianceContainer = document.getElementById('details-alliances');
            allianceContainer.innerHTML = '';
            if (!player.alliances || player.alliances.length === 0) {
                allianceContainer.innerHTML = '<span style="color:var(--text-muted);font-size:11px;">No alliances assigned</span>';
            } else {
                player.alliances.forEach(tag => {
                    const span = document.createElement('span'); span.className='alliance-tag'; span.textContent=tag; allianceContainer.appendChild(span);
                });
            }
            document.getElementById('details-edit-btn').style.display = currentUser?.isOwner ? 'inline-flex' : 'none';
            document.getElementById('details-modal').classList.add('active');
        }

        function openEditFromDetails() {
            if (!currentUser?.isOwner || !detailsPlayerId) return;
            closeModal('details-modal');
            openEditPlayerModal(detailsPlayerId);
        }

        function closeModal(modalId) { document.getElementById(modalId).classList.remove('active'); }
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('active'); });
        });

        function getFilteredPlayersForExport() {
            const searchTerm = document.getElementById('search-input').value.toLowerCase().trim();
            const filterAlliance = document.getElementById('filter-alliance').value;
            let players = currentKingdom?.players || [];
            players = [...players].sort((a,b) => a.name.localeCompare(b.name));
            if (searchTerm) players = players.filter(p => p.name.toLowerCase().includes(searchTerm) || (p.alliances||[]).some(tag => tag.toLowerCase().includes(searchTerm)));
            if (filterAlliance) players = players.filter(p => (p.alliances||[]).includes(filterAlliance));
            return players;
        }

        function downloadCSV() {
            const players = getFilteredPlayersForExport();
            const kingdomName = currentKingdom?.name || 'Kingdom';
            let csv = '\uFEFF';
            csv += 'Kingdom,Player Name,Alliances\n';
            players.forEach(p => {
                const alliances = (p.alliances||[]).join(' | ') || 'None';
                csv += `"${kingdomName}","${p.name}","${alliances}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${kingdomName}_reward_list.csv`; link.click(); URL.revokeObjectURL(link.href);
            document.getElementById('download-menu').classList.remove('show');
        }

        function downloadExcel() {
            const players = getFilteredPlayersForExport();
            const kingdomName = currentKingdom?.name || 'Kingdom';
            let html = '<html><head><meta charset="UTF-8"></head><body>';
            html += '<table border="1"><tr><th>#</th><th>Player Name</th><th>Alliances</th></tr>';
            players.forEach((p,i) => {
                const alliances = (p.alliances||[]).join(', ') || 'None';
                html += `<tr><td>${i+1}</td><td>${p.name}</td><td>${alliances}</td></tr>`;
            });
            html += '</table></body></html>';
            const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
            const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${kingdomName}_reward_list.xls`; link.click(); URL.revokeObjectURL(link.href);
            document.getElementById('download-menu').classList.remove('show');
        }

        function downloadPDF() { 
            window.print(); 
            document.getElementById('download-menu').classList.remove('show');
        }

        function init() {
            const session = getSession();
            if (session) {
                const users = getUsers();
                const user = users.find(u => u.id === session.userId);
                const kingdom = getKingdom();
                if (user && kingdom) { currentUser = user; currentKingdom = kingdom; enterDashboard(); return; }
            }
            document.getElementById('auth-screen').classList.add('active');
            document.getElementById('dashboard-screen').classList.remove('active');
            const kingdom = getKingdom();
            if (!kingdom) switchAuthTab('signup');
            else switchAuthTab('signin');
        }

        document.addEventListener('DOMContentLoaded', init);

        window.switchAuthTab = switchAuthTab;
        window.handleSignIn = handleSignIn;
        window.handleSignUp = handleSignUp;
        window.handleGuestView = handleGuestView;
        window.handleLogout = handleLogout;
        window.closeModal = closeModal;
        window.openAddPlayerModal = openAddPlayerModal;
        window.handlePlayerSubmit = handlePlayerSubmit;
        window.openPlayerDetails = openPlayerDetails;
        window.openEditPlayerModal = openEditPlayerModal;
        window.openEditFromDetails = openEditFromDetails;
        window.removePlayer = removePlayer;
        window.downloadCSV = downloadCSV;
        window.downloadExcel = downloadExcel;
        window.downloadPDF = downloadPDF;
        window.renderTable = renderTable;
        window.addAllianceInput = addAllianceInput;
        window.clearAllianceInputs = clearAllianceInputs;
        window.setAllianceInputs = setAllianceInputs;
        window.getAllianceTagsFromInputs = getAllianceTagsFromInputs;
        window.togglePasswordVisibility = togglePasswordVisibility;
        window.toggleDownloadMenu = toggleDownloadMenu;
    </script>
</body>
</html>
